# Build outputs and third-party apps (never commit an APK)
build/
*.apk
*.idsig
*.dex
*.class

# Keys and secrets
*.jks
*.keystore
*.p12
adbkey*
*.pem
*.pass

# Your local settings (contains your Googlebook's IP address and port)
ghost.env

# Browser sign-ins: these folders hold live Google session cookies
profiles/
profile-*/

# Daemon state, logs and screenshots
bridge/
logs/
*.log
*.png
*.html

# Caches and environments
__pycache__/
venv/
.venv/

# Editor and system files
.DS_Store
*.swp
