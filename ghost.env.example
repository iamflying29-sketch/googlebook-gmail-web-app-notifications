# Copy this file to ghost.env (setup.sh writes ghost.env for you) and put your Googlebook's
# Wireless debugging address here: the IP address and port shown under "IP address & Port" on
# Settings > System > Developer options > Wireless debugging.
# 192.0.2.10 is a reserved example address. Replace it and the port with your own.
ANDROID_SERIAL=192.0.2.10:41000
