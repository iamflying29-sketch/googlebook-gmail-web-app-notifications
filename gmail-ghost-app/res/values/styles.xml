<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The standard dark device theme, with the content laid out below the title bar instead of
         underneath it (apps built for Android 15 otherwise draw behind the bars). -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
